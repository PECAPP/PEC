generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "tracing"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  name                     String
  avatar                   String?
  githubUsername           String?
  linkedinUsername         String?
  isPublicProfile          Boolean                  @default(true)
  profileComplete          Boolean                  @default(false)
  role                     String                   @default("student")
  password                 String                   @default("password")
  emailVerified            Boolean                  @default(false)
  emailVerifiedAt          DateTime?
  passwordChangedAt        DateTime?
  sessionVersion           Int                      @default(0)
  failedLoginAttempts      Int                      @default(0)
  lockedUntil              DateTime?
  deletedAt                DateTime?
  attendances              Attendance[]             @relation("StudentAttendance")
  canteenOrders            CanteenOrder[]
  cgpaEntries              CgpaEntry[]
  createdClubs             Club[]                   @relation("ClubCreator")
  clubJoinRequests         ClubJoinRequest[]        @relation("ClubJoinRequester")
  reviewedClubJoinRequests ClubJoinRequest[]        @relation("ClubJoinReviewer")
  emailVerificationTokens  EmailVerificationToken[]
  enrollments              Enrollment[]             @relation("StudentEnrollments")
  facultyProfile           FacultyProfile?
  feeRecords               FeeRecord[]
  financeTransactions      FinanceTransaction[]     @relation("FinanceTransactions")
  marketplaceBookmarks     MarketplaceBookmark[]    @relation("MarketplaceBookmarks")
  marketplaceBuyerChats    MarketplaceChat[]        @relation("MarketplaceBuyerChats")
  marketplaceListings      MarketplaceListing[]     @relation("MarketplaceListings")
  marketplaceMessages      MarketplaceMessage[]     @relation("MarketplaceMessages")
  messages                 Message[]                @relation("UserMessages")
  notices                  Notice[]                 @relation("NoticeAuthor")
  notifications            Notification[]
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  studentProfile           StudentProfile?
  chatRooms                UserChatRoom[]
  roles                    UserRole[]
  settings                 UserSettings?

  @@index([emailVerified])
  @@index([lockedUntil])
  @@index([email], map: "idx_user_active", where: raw("(\"deletedAt\" IS NULL)"))
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  theme              String   @default("system")
  accentColor        String   @default("pec-gold")
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  locale             String   @default("en")
  timezone           String   @default("Asia/Kolkata")
  sidebarState       String   @default("expanded")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CgpaEntry {
  id          String    @id @default(uuid())
  userId      String
  courseId    String?
  subjectName String
  courseCode  String?
  semester    Int
  credits     Float
  gradePoint  Float
  courseType  String    @default("core")
  examDate    DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semester])
  @@index([userId, createdAt])
}

model HostelIssue {
  id             String    @id @default(uuid())
  title          String    @default("")
  studentId      String
  studentName    String?
  hostelName     String    @default("Hostel")
  roomNumber     String
  category       String
  description    String
  images         String[]  @default([])
  status         String    @default("Open")
  priority       String    @default("Medium")
  organizationId String?
  responses      Json?
  slaDeadline    DateTime?
  isEscalated    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([studentId, status])
  @@index([hostelName, status])
  @@index([category])
  @@index([createdAt])
  @@index([organizationId])
  @@index([isEscalated])
}

model HostelOutpass {
  id            String   @id @default(uuid())
  studentId     String
  studentName   String?
  hostelName    String
  roomNumber    String
  reason        String
  destination   String
  departureDate DateTime
  returnDate    DateTime
  status        String   @default("Pending") // Pending, Approved, Rejected, Active, Completed
  approvedBy    String?
  qrCode        String?  @unique
  evidenceUrl   String?
  images        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId, status])
  @@index([hostelName, status])
  @@index([status, departureDate])
}

model CampusMapRegion {
  id             String   @id @default(uuid())
  name           String
  description    String
  x              Float
  y              Float
  width          Float
  height         Float
  type           String
  color          String?
  category       String   @default("general")
  link           String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([organizationId, category])
}

model CollegeSettings {
  id                           String   @id @default("main")
  name                         String   @default("PEC University")
  shortName                    String   @default("PEC")
  logo                         String?
  primaryColor                 String   @default("#000000")
  secondaryColor               String   @default("#ffffff")
  accentColor                  String   @default("#4f46e5")
  attendanceRequiredPercentage Float    @default(75)
  academicSession              String   @default("2024-25")
  semester                     Int      @default(1)
  allowRegistration            Boolean  @default(true)
  allowLogin                   Boolean  @default(true)
  lastUpdatedBy                String?
  updatedAt                    DateTime @updatedAt
}

model CampusMapRoad {
  id             String   @id @default(uuid())
  points         Json
  width          Float
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model CourseMaterial {
  id          String   @id @default(uuid())
  courseId    String
  courseName  String
  courseCode  String
  title       String
  description String   @default("")
  fileURL     String
  type        String   @default("other")
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, type])
  @@index([uploadedBy])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  hierarchy   Int              @default(1)
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String // e.g. "create", "read", "update", "delete", "manage"
  subject     String // e.g. "HostelIssue", "all"
  conditions  Json? // e.g. { "studentId": "{{id}}" }
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([action, subject])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt]) // For scheduled pruning of expired tokens
  @@index([usedAt]) // For cleanup of used tokens
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt]) // For scheduled pruning of expired tokens
  @@index([usedAt]) // For cleanup of used tokens
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  enrollmentNumber String    @unique
  department       String
  semester         Int
  phone            String?
  dob              DateTime?
  address          String?
  bio              String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department, semester])
}

model FacultyProfile {
  id             String                @id @default(uuid())
  userId         String                @unique
  employeeId     String                @unique
  department     String
  designation    String
  phone          String?
  specialization String?
  qualifications String?
  bio            String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications   FacultyPublication[]
  awards         FacultyAward[]
  conferences    FacultyConference[]
  consultations  FacultyConsultation[]

  @@index([department, designation])
}

model Department {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String   @unique
  hod            String?
  description    String?
  status         String   @default("active")
  timetableLabel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, name])
}

model Course {
  id               String         @id @default(uuid())
  code             String         @unique
  name             String
  credits          Int
  instructor       String
  department       String
  semester         Int
  status           String
  facultyId        String?
  capacity         Int            @default(60)
  prerequisiteIds  String[]       @default([])
  deletedAt        DateTime?
  enrollments      Enrollment[]   @relation("CourseEnrollments")
  examSchedules    ExamSchedule[]
  timetableEntries Timetable[]    @relation("CourseTimetable")

  @@index([department, semester])
  @@index([status], map: "idx_course_active", where: raw("(\"deletedAt\" IS NULL)"))
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  courseName String
  courseCode String
  semester   Int?
  batch      String?
  status     String   @default("active")
  enrolledAt DateTime @default(now())
  course     Course   @relation("CourseEnrollments", fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId, status])
  @@index([courseId, status])
  @@index([enrolledAt])
}

model FeeRecord {
  id                      String               @id @default(uuid())
  studentId               String
  amount                  Float
  description             String
  dueDate                 DateTime
  category                String
  status                  String               @default("pending")
  semester                String?
  month                   String?
  lateFeeApplied          Boolean              @default(false)
  lateFeeAmount           Float                @default(0)
  paidDate                DateTime?
  pendingTransactionId    String?
  paymentTransactionId    String?
  lastPaymentAttempt      DateTime?
  verificationSubmittedAt DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  student                 User                 @relation(fields: [studentId], references: [id])
  transactions            FinanceTransaction[]

  @@index([studentId, status])
  @@index([category, status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([studentId, status], map: "idx_feerecord_active", where: raw("(\"deletedAt\" IS NULL)"))
}

model FinanceTransaction {
  id            String    @id @default(cuid())
  studentId     String
  feeRecordId   String
  amount        Float
  paymentMethod String    @default("online")
  status        String
  gatewayTxnId  String?
  receiptNo     String    @unique
  notes         String?
  createdAt     DateTime  @default(now())
  feeRecord     FeeRecord @relation(fields: [feeRecordId], references: [id])
  student       User      @relation("FinanceTransactions", fields: [studentId], references: [id])

  @@index([studentId, status])
  @@index([feeRecordId, status])
  @@index([createdAt])
}

model Timetable {
  id          String   @id @default(uuid())
  courseId    String?
  courseName  String
  courseCode  String
  facultyId   String?
  facultyName String?
  day         String
  startTime   String
  endTime     String
  room        String
  department  String?
  semester    Int?
  batch       String?
  createdAt   DateTime @default(now())
  course      Course?  @relation("CourseTimetable", fields: [courseId], references: [id])

  @@index([courseId])
  @@index([department, semester, batch])
  @@index([day, startTime])
}

model Room {
  id          String   @id @default(uuid())
  name        String
  type        String
  capacity    Int
  building    String
  floor       Int
  facilities  String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([building, floor])
  @@index([type, isAvailable])
}

model ChatRoom {
  id           String         @id @default(cuid())
  name         String
  isGroup      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  club         Club?
  messages     Message[]
  participants UserChatRoom[]

  @@unique([name, isGroup])
  @@index([createdAt])
}

model Notice {
  id            String    @id @default(uuid())
  title         String
  content       String
  category      String    @default("update")
  important     Boolean   @default(false)
  priorityLevel Int       @default(1)
  pinned        Boolean   @default(false)
  mediaJson     String?
  authorId      String?
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  author        User?     @relation("NoticeAuthor", fields: [authorId], references: [id])

  @@index([pinned, priorityLevel, publishedAt])
  @@index([category, publishedAt])
  @@index([authorId])
  @@index([category], map: "idx_notice_active", where: raw("(\"deletedAt\" IS NULL)"))
}

model Club {
  id           String            @id @default(uuid())
  name         String            @unique
  chatRoomId   String            @unique
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  chatRoom     ChatRoom          @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("ClubCreator", fields: [createdById], references: [id])
  joinRequests ClubJoinRequest[]

  @@index([createdById])
}

model ClubJoinRequest {
  id           String    @id @default(uuid())
  clubId       String
  requesterId  String
  proposalText String
  mediaJson    String?
  status       String    @default("pending")
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requester    User      @relation("ClubJoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("ClubJoinReviewer", fields: [reviewedById], references: [id])

  @@unique([clubId, requesterId])
  @@index([clubId, status])
  @@index([requesterId, status])
  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  senderId   String
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
  @@index([senderId, createdAt])
}

model UserChatRoom {
  userId     String
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chatRoomId])
  @@index([chatRoomId])
}

model Attendance {
  id        String             @id @default(cuid())
  date      DateTime
  status    String
  subject   String
  studentId String
  sessionId String?
  markedAt  DateTime?          @default(now())
  method    String?            @default("manual")
  courseId  String?
  facultyId String?
  lat       Float?
  lng       Float?
  session   AttendanceSession? @relation("SessionAttendance", fields: [sessionId], references: [id])
  student   User               @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, subject])
  @@index([date])
  @@index([status])
  @@index([sessionId])
}

model AttendanceSession {
  id              String       @id @default(uuid())
  facultyId       String
  courseId        String
  courseName      String
  date            String
  startTime       String
  qrCode          String       @unique
  active          Boolean      @default(true)
  expiresAt       String
  attendanceCount Int          @default(0)
  createdAt       DateTime     @default(now())
  endedAt         DateTime?
  attendances     Attendance[] @relation("SessionAttendance")

  @@index([facultyId])
  @@index([courseId])
  @@index([qrCode])
}

model ExamSchedule {
  id         String    @id @default(uuid())
  courseId   String
  courseName String
  courseCode String
  examType   String
  date       DateTime
  startTime  String
  endTime    String
  room       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, date])
  @@index([courseId], map: "idx_exam_active", where: raw("(\"deletedAt\" IS NULL)"))
}

model Job {
  id         String    @id @default(uuid())
  title      String
  company    String
  location   String
  type       String
  salary     String?
  deadline   DateTime
  matchScore Int?
  deletedAt  DateTime?

  @@index([deadline])
  @@index([type, location])
  @@index([company])
  @@index([deadline], map: "idx_job_active", where: raw("(\"deletedAt\" IS NULL)"))
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorRole   String?
  action      String
  entity      String
  entityId    String?
  method      String
  path        String
  ip          String?
  statusCode  Int?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  payload     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, updatedAt])
}

model BackgroundJob {
  id           String    @id @default(uuid())
  type         String
  status       String    @default("pending")
  payload      String?
  dedupeKey    String?   @unique
  runAt        DateTime  @default(now())
  availableAt  DateTime  @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  processedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([type, status, availableAt])
  @@index([lockedAt])
  @@index([processedAt])
}

model CanteenItem {
  id          String             @id @default(uuid())
  name        String             @unique
  price       Float
  category    String
  description String?
  image       String?
  isAvailable Boolean            @default(true)
  stock       Int                @default(100)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orders      CanteenOrderItem[]

  @@index([category, isAvailable])
}

model CanteenOrder {
  id          String             @id @default(uuid())
  studentId   String
  studentName String?
  hostelRoom  String
  totalAmount Float
  status      String             @default("Pending")
  timestamp   DateTime           @default(now())
  student     User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items       CanteenOrderItem[]

  @@index([studentId, status])
  @@index([timestamp])
}

model CanteenOrderItem {
  id       String       @id @default(uuid())
  orderId  String
  itemId   String
  name     String
  quantity Int
  price    Float
  item     CanteenItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order    CanteenOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ScoreEntry {
  id         String    @id @default(uuid())
  studentId  String
  courseName String
  courseCode String?
  term       String?
  maxMarks   Float     @default(100)
  score      Float     @default(0)
  grade      String?
  examDate   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([studentId])
  @@index([studentId, createdAt])
}

model ResumeProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  personalInfo Json?
  education    Json?
  experience   Json?
  projects     Json?
  skills       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model StudentProject {
  id          String    @id @default(uuid())
  studentId   String
  title       String
  description String
  techStack   String
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  startDate   DateTime?
  endDate     DateTime?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId])
  @@index([studentId, isFeatured])
}

model StudentSkill {
  id        String   @id @default(uuid())
  studentId String
  name      String
  level     Int      @default(50)
  category  String   @default("technical")
  createdAt DateTime @default(now())

  @@unique([studentId, name])
  @@index([studentId, category])
}

model FacultyPublication {
  id         String         @id @default(uuid())
  facultyId  String
  faculty    FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  title      String
  journal    String?
  conference String?
  year       Int
  doi        String?
  url        String?
  abstract   String?
  citations  Int            @default(0)
  coAuthors  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([facultyId])
  @@index([facultyId, year])
}

model FacultyAward {
  id          String         @id @default(uuid())
  facultyId   String
  faculty     FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  awardedBy   String?
  year        Int
  category    String         @default("academic")
  createdAt   DateTime       @default(now())

  @@index([facultyId])
  @@index([facultyId, year])
}

model FacultyConference {
  id                String         @id @default(uuid())
  facultyId         String
  faculty           FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  name              String
  location          String?
  startDate         DateTime?
  endDate           DateTime?
  role              String?        @default("presenter")
  presentationTitle String?
  description       String?
  createdAt         DateTime       @default(now())

  @@index([facultyId])
  @@index([facultyId, startDate])
}

model FacultyConsultation {
  id           String         @id @default(uuid())
  facultyId    String
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  organization String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([facultyId])
  @@index([facultyId, status])
}

model AcademicCalendarEvent {
  id             String    @id @default(uuid())
  title          String
  description    String    @default("")
  date           DateTime
  endDate        DateTime?
  startTime      String?
  endTime        String?
  eventType      String
  category       String    @default("academic")
  location       String?
  importance     String    @default("medium")
  targetAudience String?
  rawData        Json?
  isEditable     Boolean   @default(true)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([date, eventType])
  @@index([category])
  @@index([importance])
  @@index([date])
}

model MarketplaceListing {
  id          String                @id @default(uuid())
  title       String
  description String                @default("")
  price       Float
  category    String
  condition   String
  images      String[]
  status      String                @default("Available")
  sellerId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  bookmarks   MarketplaceBookmark[]
  chats       MarketplaceChat[]
  seller      User                  @relation("MarketplaceListings", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceBookmark {
  id        String             @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime           @default(now())
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User               @relation("MarketplaceBookmarks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model MarketplaceChat {
  id          String               @id @default(uuid())
  listingId   String
  buyerId     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  offerAmount Float?
  offerStatus String? // "PENDING", "ACCEPTED", "REJECTED"
  buyer       User                 @relation("MarketplaceBuyerChats", fields: [buyerId], references: [id], onDelete: Cascade)
  listing     MarketplaceListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages    MarketplaceMessage[]

  @@unique([listingId, buyerId])
  @@index([listingId])
  @@index([buyerId])
}

model MarketplaceMessage {
  id          String          @id @default(cuid())
  chatId      String
  senderId    String
  text        String
  isOffer     Boolean         @default(false)
  offerAmount Float?
  offerStatus String? // "PENDING", "ACCEPTED", "REJECTED", "WITHDRAWN"
  createdAt   DateTime        @default(now())
  chat        MarketplaceChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User            @relation("MarketplaceMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
}
