    "flatted": "^3.4.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "multer": "^2.1.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.33.0",
