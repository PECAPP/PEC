    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "path-to-regexp": "^8.4.1",
    "pg": "^8.11.5",
    "picomatch": "^4.0.4",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.2",
    "swagger-ui-express": "^5.0.1",
    "tar": "^7.5.13",
    "undici": "^7.24.6",
    "zod": "^3.24.1"
