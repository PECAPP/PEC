    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@pec/database": "workspace:*",
    "@pec/protos": "workspace:*",
    "@pec/shared": "workspace:*",
