{
  "name": "pec-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "api": "cd server && npx nest start --watch --swc",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",

    "seed": "npm run db:seed",
    "db:seed": "ts-node seed.ts",
    "db:seed-permissions": "ts-node seed-permissions.ts",
    "db:check": "ts-node check_db.ts",
    "db:backup": "node scripts/db-backup.js",
    "db:backup:dry": "node scripts/db-backup.js --dry-run",
    "db:restore": "node scripts/db-restore.js",
    "db:restore:dry": "node scripts/db-restore.js --dry-run --file backup.dump",
    "db:clean": "node scripts/db-clean.js --force",
    "db:clean:confirm": "node scripts/db-clean.js",
    "db:migrate-sqlite": "node scripts/migrate-sqlite-to-postgres.js",
    "start": "nest start",
    "start:dev": "npx nodemon --signal SIGTERM --watch src -e ts --exec \"npx swc src -d dist && node --experimental-strip-types dist/src/main.js\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/apps/server/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@casl/ability": "^7.0.0",
    "@casl/prisma": "^2.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.0",
    "@google/generative-ai": "^0.24.1",
    "@keyv/redis": "^5.1.6",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.1.27",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.26",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@pec/database": "workspace:*",
    "@pec/env": "workspace:*",
    "@pec/shared": "workspace:*",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@prisma/instrumentation": "^7.8.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/node": "^10.56.0",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "exceljs": "^4.4.0",
    "ioredis": "^5.3.2",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^4.3.1",
    "openai": "^6.33.0",
    "otplib": "^13.4.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.5",
    "@angular-devkit/schematics": "^21.2.5",
    "@angular-devkit/schematics-cli": "^21.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}