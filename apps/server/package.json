    "@ts-rest/nest": "^3.52.1",
    "@types/multer": "^2.1.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "ajv": "^8.18.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.10.0",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
