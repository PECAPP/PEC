{
  "name": "pec-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "api": "cd server && npx nest start --watch --swc",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "npm run db:seed",
    "db:seed": "ts-node seed.ts",
    "db:check": "ts-node check_db.ts",
    "db:backup": "node scripts/db-backup.js",
    "db:backup:dry": "node scripts/db-backup.js --dry-run",
    "db:restore": "node scripts/db-restore.js",
    "db:restore:dry": "node scripts/db-restore.js --dry-run --file backup.dump",
    "db:clean": "node scripts/db-clean.js --force",
    "db:clean:confirm": "node scripts/db-clean.js",
    "db:migrate-sqlite": "node scripts/migrate-sqlite-to-postgres.js",
    "start": "nest start",
    "start:dev": "node scripts/start-dev-safe.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/apps/server/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
