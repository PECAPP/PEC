    "ts-morph": "^28.0.0",
    "turbo": "^2.9.16",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "win32"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}