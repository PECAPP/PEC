{
  "name": "pec-campus-erp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "npm run dev:host",
    "dev:turbo": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "frontend": "pnpm --filter pec-frontend dev",
    "api": "pnpm --filter pec-server start:dev",
    "sync:api": "pnpm --filter @pec/api generate",
    "db:reset": "pnpm --filter pec-server db:clean && pnpm --filter pec-server db:push && pnpm --filter pec-server db:seed",
    "predev:host": "npx kill-port 3001",
    "dev:host": "concurrently --kill-others-on-fail \"npm run frontend\" \"npm run api\"",
    "check:env": "node scripts/check_env.js",
    "dev:docker:logs": "docker compose -f docker-compose.dev.yml logs -f --tail=100",
    "dev:docker:restart": "docker compose -f docker-compose.dev.yml restart",
    "dev:local": "docker compose -f docker-compose.dev.yml up -d",
    "prod:docker": "docker compose up -d --build",
    "prod:docker:down": "docker compose down",
    "setup": "pnpm install && pnpm --filter pec-server db:push && pnpm --filter pec-server prisma:generate && pnpm --filter pec-server db:seed",
    "clean:full": "node -e \"const fs=require('fs');['node_modules','apps/server/node_modules','apps/frontend/.next','apps/server/dist'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})); console.log('Cleaned all artifacts.')\"",
    "clean:next": "node -e \"require('fs').rmSync('apps/frontend/.next',{recursive:true,force:true});console.log('cleaned .next')\"",
    "db:studio": "npx prisma studio --schema packages/database/prisma/schema.prisma",
    "start": "pnpm --filter pec-frontend start",
    "start:fresh": "npm run clean:next && pnpm --filter pec-frontend build && pnpm --filter pec-frontend start",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "resolutions": {
    "uuid": "^11.1.1",
    "eslint-plugin-react": "7.34.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "postcss": "^8.5.10",
    "@hono/node-server": "^1.19.13",
    "chokidar": "^5.0.0",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "turbo": "^2.9.16",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}